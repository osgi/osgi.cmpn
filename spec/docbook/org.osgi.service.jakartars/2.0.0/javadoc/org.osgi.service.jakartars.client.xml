   <section xreflabel="SseEventSourceFactory"
            role="class"
            xml:id="org.osgi.service.jakartars.client.SseEventSourceFactory">
      <title>public interface SseEventSourceFactory</title>
      <para>
A factory for SseEventSource instances.
 </para>
      <para>
 Bundles may obtain an instance of a <link linkend="org.osgi.service.jakartars.client.SseEventSourceFactory">SseEventSourceFactory</link> using the
 service registry. This service may then be used to construct
 SseEventSource instances for the supplied WebTarget.</para>
      <formalpara role="parameter">
         <title>Provider Type</title>
         <para>Consumers of this API must not implement this type</para>
      </formalpara>
      <section xreflabel="newBuilder(jakarta.ws.rs.client.WebTarget)"
               role="method"
               xml:id="org.osgi.service.jakartars.client.SseEventSourceFactory.newBuilder-jakarta.ws.rs.client.WebTarget-">
         <title>public SseEventSource.Builder newBuilder(WebTarget target)</title>
         <formalpara role="parameter">
            <title>target</title>
            <para>The web target to consume events from</para>
         </formalpara>
         <para role="description">
Create a new jakarta.ws.rs.sse.SseEventSource.Builder</para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>a builder which can be used to further configure the event source</para>
         </formalpara>
      </section>
      <section xreflabel="newSource(jakarta.ws.rs.client.WebTarget)"
               role="method"
               xml:id="org.osgi.service.jakartars.client.SseEventSourceFactory.newSource-jakarta.ws.rs.client.WebTarget-">
         <title>public SseEventSource newSource(WebTarget target)</title>
         <formalpara role="parameter">
            <title>target</title>
            <para>The web target to consume events from</para>
         </formalpara>
         <para role="description">
Create a new SseEventSource</para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>a configured event source</para>
         </formalpara>
      </section>
   </section>
