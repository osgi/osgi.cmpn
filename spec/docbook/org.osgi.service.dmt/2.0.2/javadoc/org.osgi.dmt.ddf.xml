   <section xreflabel="NODE" role="class" xml:id="org.osgi.dmt.ddf.NODE">
      <title>public interface NODE</title>
      <para>
The NODE represents a node in the Device Management Tree.
   </para>
      <section xreflabel="getChildren()"
               role="method"
               xml:id="org.osgi.dmt.ddf.NODE.getChildren--">
         <title>public Iterator&lt;NODE&gt; getChildren()</title>
         <para role="description">
The children of this node or <code>null</code> if this is a leaf node.
   </para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>the children of this node.</para>
         </formalpara>
      </section>
      <section xreflabel="getName()"
               role="method"
               xml:id="org.osgi.dmt.ddf.NODE.getName--">
         <title>public String getName()</title>
         <para role="description">
The node's name in the tree. This is only the name, not the complete
 path.
   </para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>Node's name</para>
         </formalpara>
      </section>
      <section xreflabel="getParent()"
               role="method"
               xml:id="org.osgi.dmt.ddf.NODE.getParent--">
         <title>public NODE getParent()</title>
         <para role="description">
Return the parent node of this node.
   </para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>the parent node.</para>
         </formalpara>
      </section>
      <section xreflabel="getPath()"
               role="method"
               xml:id="org.osgi.dmt.ddf.NODE.getPath--">
         <title>public String getPath()</title>
         <para role="description">
The complete path up unto the root of the current session.
   </para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>the relative part unto the root of the current session.</para>
         </formalpara>
      </section>
      <section xreflabel="getValue(Class)"
               role="method"
               xml:id="org.osgi.dmt.ddf.NODE.getValue-Class-">
         <title>public T getValue(Class&lt;T&gt; type)</title>
         <formalpara role="parameter">
            <title>Type Parameters</title>
            <para>
               <code>&lt;T&gt;</code>
            </para>
         </formalpara>
         <formalpara role="parameter">
            <title>&lt;T&gt;</title>
            <para>The requested type</para>
         </formalpara>
         <formalpara role="parameter">
            <title>type</title>
            <para>the class representing the requested type</para>
         </formalpara>
         <para role="description">
Only for a leaf node, return its value converted to the given type.
   </para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>A converted object or <code>null</code>.</para>
         </formalpara>
      </section>
   </section>
