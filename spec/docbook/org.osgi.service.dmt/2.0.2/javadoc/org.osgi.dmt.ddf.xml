   <section xreflabel="MAP" role="class" xml:id="org.osgi.dmt.ddf.MAP">
      <title>public interface MAP&lt;K, V&gt;<?line-break?> extends NODE</title>
      <formalpara role="parameter">
         <title>&lt;K&gt;</title>
         <para>The key type. Must be a type that is convertable from/to String
        for the child's name.</para>
      </formalpara>
      <formalpara role="parameter">
         <title>&lt;V&gt;</title>
         <para>The value type, can be any type mapping to a node.</para>
      </formalpara>
      <para>
A Multiple represents a base node with its direct children. The child's name
 is used as the key. A Multiple's children have a cardinality of 0..n. The
 entry can be made optional by wrapping it in an Optional.
   </para>
      <section xreflabel="entrySet()"
               role="method"
               xml:id="org.osgi.dmt.ddf.MAP.entrySet--">
         <title>public Collection&lt;Map.Entry&lt;K, V&gt;&gt; entrySet()</title>
         <para role="description">
Return the set of Map.Entry objects for this Multiple.
   </para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>An entry set over the key/value entries.</para>
         </formalpara>
      </section>
      <section xreflabel="get(K)"
               role="method"
               xml:id="org.osgi.dmt.ddf.MAP.get-K-">
         <title>public V get(K key)</title>
         <formalpara role="parameter">
            <title>key</title>
            <para>The name of the child node.</para>
         </formalpara>
         <para role="description">
Get a value. The given key is the name of a child node, the result is a
 NODE at that position or its value when it is a leaf node that can only
 be gotten.
   </para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>The value for a given key</para>
         </formalpara>
      </section>
      <section xreflabel="keySet()"
               role="method"
               xml:id="org.osgi.dmt.ddf.MAP.keySet--">
         <title>public Collection&lt;K&gt; keySet()</title>
         <para role="description">
Return the set of keys for this Multiple.
   </para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>the set of keys</para>
         </formalpara>
      </section>
      <section xreflabel="values()"
               role="method"
               xml:id="org.osgi.dmt.ddf.MAP.values--">
         <title>public Collection&lt;V&gt; values()</title>
         <para role="description">
Return the set of values for this Multiple.
   </para>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>the set of keys</para>
         </formalpara>
      </section>
   </section>
